# Which LLM provider to use: GEMINI or TECENT
MODEL_PROVIDER=GEMINI

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Tencent Hunyuan (via OpenRouter, OpenAI-compatible API)
OPENAI_TECENT_KEY=your_openrouter_api_key_here

# Semantic cache tuning (optional — defaults shown)
# Max cosine distance for a cache hit; lower = stricter matching
#DISTANCE_THRESHOLD=0.30
# Sentence-transformers model used to embed questions
#EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
